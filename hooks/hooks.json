{
  "description": "Warn (non-blocking): before committing an EAS build artifact, and before uploading one that may not have passed the artifact gate.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-build-artifacts.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-artifact-upload.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
